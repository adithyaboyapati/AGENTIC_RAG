# LLM Provider (default: OpenAI)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024

# Environment: development | production
ENVIRONMENT=development

# Vector store
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=agentic_rag_docs

# Retrieval
RETRIEVAL_TOP_K=4

# Agent
MAX_RETRIEVAL_RETRIES=2
GRADER_RELEVANCE_THRESHOLD=0.5
MAX_MULTI_HOP_STEPS=3

# API security (auth is ALWAYS enforced when ENVIRONMENT=production)
API_KEY=change-me-to-a-long-random-secret
REQUIRE_API_KEY=false
CORS_ORIGINS=*

# Rate limits
MAX_QUERIES_PER_MINUTE=60
MAX_QUERIES_PER_MINUTE_PER_CLIENT=20
MAX_TOKENS_PER_QUERY=2000
MAX_TOKENS_PER_MINUTE=10000
MAX_TOKENS_PER_HOUR=100000
REQUEST_TIMEOUT_SECONDS=120

# Privacy
REDACT_OUTPUT_PII=true
BLOCK_OUTPUT_PII=false

# API server
API_WORKERS=1

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-rag

# Conversation memory (optional Supabase)
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=6
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_CHAT_TABLE=chat_messages
