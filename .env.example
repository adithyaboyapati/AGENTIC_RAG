# LLM Provider (default: OpenAI)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024

# Optional Groq fallback — used automatically when OpenAI calls fail
# (rate limit / insufficient quota / outages). Embeddings stay on OpenAI.
LLM_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_COST_PER_1K_INPUT_USD=0.00059
GROQ_COST_PER_1K_OUTPUT_USD=0.00079

# Environment: development | production
ENVIRONMENT=development

# Vector store
# persistent (local/dev default) | http (docker-compose default)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
COLLECTION_NAME=agentic_rag_docs

# Ingestion / chunking
# section_parent_child (default) | fixed
CHUNKING_STRATEGY=section_parent_child
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=500
CHILD_CHUNK_OVERLAP=80
PARENT_MAX_CHARS=3500
EXPAND_TO_PARENT=true
PARENT_STORE_PATH=./data/parent_store.json

# Ingestion cleansing
CLEANSE_ENABLED=true
CLEANSE_HEADERS_FOOTERS=true
CLEANSE_TOP_MARGIN_RATIO=0.06
CLEANSE_BOTTOM_MARGIN_RATIO=0.06
CLEANSE_MIN_REPEAT_PAGES=3
CLEANSE_DROP_PAGE_NUMBERS=true
CLEANSE_DROP_BOILERPLATE=true
CLEANSE_FIX_HYPHENATION=true
CLEANSE_DROP_IRRELEVANT_SECTIONS=true
CLEANSE_DROP_TABLE_SCAFFOLD=true
# Optional comma-separated exact titles (overrides built-in References/Appendix/…)
# DROP_SECTION_TITLES=References,Acknowledgments

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
# similarity | mmr | hybrid
RETRIEVAL_SEARCH_TYPE=hybrid
RETRIEVAL_MMR_LAMBDA=0.5
RETRIEVAL_RRF_K=60

# Cross-encoder reranking (after candidate fetch, before top_k)
RERANK_ENABLED=true
# nvidia (NeMo Retriever API) | flashrank (local ONNX)
RERANK_PROVIDER=nvidia
# nvidia model examples:
#   nvidia/llama-nemotron-rerank-vl-1b-v2  (multimodal; works great on text too)
#   nvidia/nv-rerankqa-mistral-4b-v3
# flashrank model examples:
#   ms-marco-MiniLM-L-12-v2 | ms-marco-TinyBERT-L-2-v2
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
RERANK_CACHE_DIR=./data/flashrank_cache
RERANK_MAX_LENGTH=512

# NVIDIA API key from https://build.nvidia.com (required when RERANK_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://ai.api.nvidia.com/v1
# Optional full URL override (leave empty to auto-build from model slug)
# NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nv-rerankqa-mistral-4b-v3/reranking
NVIDIA_RERANK_TRUNCATE=END
NVIDIA_RERANK_TIMEOUT_SECONDS=30

# Agent
MAX_RETRIEVAL_RETRIES=2
GRADER_RELEVANCE_THRESHOLD=0.5
MAX_MULTI_HOP_STEPS=3

# Optional online quality checks (extra LLM calls)
QUALITY_GUARDRAILS_ENABLED=false

# Phase 8: Multi-Agent Consensus Debate
CONSENSUS_AGENT_ENABLED=true
# Graph is a single propose → challenge → judge pass (reserved for future rounds)
CONSENSUS_MAX_ROUNDS=1
# Below this score, a grounding caveat is appended to the answer
CONSENSUS_MIN_CONFIDENCE=0.80

# API security (auth is ALWAYS enforced when ENVIRONMENT=production)
# Generate with: openssl rand -hex 32   (min 32 chars enforced in production)
API_KEY=change-me-to-a-long-random-secret
REQUIRE_API_KEY=false
# '*' is rejected at startup in production — list explicit origins there.
CORS_ORIGINS=*
# /metrics and /health/ready describe internal topology, so they are gated by
# API_KEY independently of REQUIRE_API_KEY. Set false only when the network
# layer already restricts them. /health stays public for liveness probes.
PROTECT_METRICS_ENDPOINT=true
PROTECT_READINESS_ENDPOINT=true

# Rate limits
MAX_QUERIES_PER_MINUTE=60
MAX_QUERIES_PER_MINUTE_PER_CLIENT=20
MAX_TOKENS_PER_QUERY=2000
MAX_TOKENS_PER_MINUTE=30000
MAX_TOKENS_PER_HOUR=100000
# auto | redis | memory — shared across workers when Redis is up
RATE_LIMIT_BACKEND=auto
TRUST_PROXY_HEADERS=false
# Comma-separated; empty disables TrustedHostMiddleware
TRUSTED_HOSTS=
IDEMPOTENCY_TTL_SECONDS=86400
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=60

# Request handling
# Per-request budget for POST /query, and the gap between SSE events.
REQUEST_TIMEOUT_SECONDS=120
# Total wall-clock budget for one SSE run (a slow-but-steady stream would
# otherwise never hit REQUEST_TIMEOUT_SECONDS).
STREAM_TIMEOUT_SECONDS=300
# Agent runs allowed in flight. Beyond this, requests wait briefly then get a
# 503 + Retry-After instead of queueing and blowing up concurrent LLM spend.
MAX_CONCURRENT_QUERIES=8
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=5

# Privacy — off | redact | block, applied independently to input and output.
#   off    = pass through untouched
#   redact = mask the sensitive span and continue (default)
#   block  = reject the request/response
PRIVACY_INPUT_MODE=redact
PRIVACY_OUTPUT_MODE=redact
# PHI is a separate risk class from PII: "what is diabetes?" is a topic, not a
# disclosure. Enable only for clinical corpora.
PRIVACY_DETECT_PHI=false
PRIVACY_RETENTION_DAYS=30
# Deprecated (still honoured, mapped to the modes above, warned at startup):
#   REDACT_OUTPUT_PII / BLOCK_OUTPUT_PII

# API server
API_WORKERS=1

# Response cache (optional Redis — final answers for identical question+mode)
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-rag

# Conversation memory (optional Supabase)
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=6
MEMORY_RECENT_EXCHANGES=3
MEMORY_ANSWER_MAX_CHARS=500
MEMORY_MAX_OLDER_QUERIES=10
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_CHAT_TABLE=chat_messages
