# Production environment template — copy to .env.production and fill in secrets
# NEVER commit .env.production with real keys

ENVIRONMENT=production

# LLM
OPENAI_API_KEY=sk-your-production-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024

# Vector store (must match ingested collection)
CHROMA_PERSIST_DIR=/data/chroma_db
COLLECTION_NAME=agentic_rag_docs

# Retrieval
RETRIEVAL_TOP_K=5

# Agent
MAX_RETRIEVAL_RETRIES=3
GRADER_RELEVANCE_THRESHOLD=0.6
MAX_MULTI_HOP_STEPS=3

# API security — auth is ALWAYS enforced in production; server refuses to
# start without API_KEY. Generate with: openssl rand -hex 32
API_KEY=generate-a-long-random-secret-here
REQUIRE_API_KEY=true
CORS_ORIGINS=https://your-frontend.example.com

# Rate limits
MAX_QUERIES_PER_MINUTE=30
MAX_QUERIES_PER_MINUTE_PER_CLIENT=10
MAX_TOKENS_PER_QUERY=2000
MAX_TOKENS_PER_MINUTE=10000
MAX_TOKENS_PER_HOUR=100000
REQUEST_TIMEOUT_SECONDS=120

# Privacy
REDACT_OUTPUT_PII=true
BLOCK_OUTPUT_PII=false

# API server (use 1 worker unless using Redis for rate limits)
API_WORKERS=1

# LangSmith (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-rag-prod
