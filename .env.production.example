# Production environment template — copy to .env.production and fill in secrets
# NEVER commit .env.production with real keys

ENVIRONMENT=production

# LLM
OPENAI_API_KEY=sk-your-production-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=1024

# Optional Groq fallback when OpenAI is rate-limited / out of quota
LLM_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_COST_PER_1K_INPUT_USD=0.00059
GROQ_COST_PER_1K_OUTPUT_USD=0.00079

# Vector store — docker-compose uses Chroma HTTP server
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_PERSIST_DIR=/data/chroma_db
COLLECTION_NAME=agentic_rag_docs

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_SEARCH_TYPE=hybrid

# Cross-encoder reranking (NVIDIA NeMo Retriever)
RERANK_ENABLED=true
RERANK_PROVIDER=nvidia
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_API_BASE=https://ai.api.nvidia.com/v1
NVIDIA_RERANK_TRUNCATE=END

# Agent
MAX_RETRIEVAL_RETRIES=3
GRADER_RELEVANCE_THRESHOLD=0.6
MAX_MULTI_HOP_STEPS=3

# API security — auth is ALWAYS enforced in production; the server refuses to
# start without API_KEY, with a key shorter than 32 chars, or with CORS_ORIGINS='*'.
# Generate with: openssl rand -hex 32
API_KEY=generate-a-long-random-secret-here
REQUIRE_API_KEY=true
CORS_ORIGINS=https://your-frontend.example.com
# The compose stack sets PROTECT_METRICS_ENDPOINT=false because Prometheus
# scrapes over the internal network and no host port is published. Running the
# API outside compose? Leave both true and give your scraper an X-API-Key.
PROTECT_METRICS_ENDPOINT=true
PROTECT_READINESS_ENDPOINT=true

# Rate limits
MAX_QUERIES_PER_MINUTE=30
MAX_QUERIES_PER_MINUTE_PER_CLIENT=10
MAX_TOKENS_PER_QUERY=2000
MAX_TOKENS_PER_MINUTE=30000
MAX_TOKENS_PER_HOUR=100000
RATE_LIMIT_BACKEND=redis
TRUST_PROXY_HEADERS=true
TRUSTED_HOSTS=your-frontend.example.com,localhost
IDEMPOTENCY_TTL_SECONDS=86400
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=60

# Request handling
REQUEST_TIMEOUT_SECONDS=120
STREAM_TIMEOUT_SECONDS=300
# Tune against your provider's concurrency limits and your cost ceiling.
MAX_CONCURRENT_QUERIES=8
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=5

# Privacy — off | redact | block (see .env.example for the full explanation)
PRIVACY_INPUT_MODE=redact
PRIVACY_OUTPUT_MODE=redact
PRIVACY_DETECT_PHI=false
PRIVACY_RETENTION_DAYS=30

# API server. >1 worker REQUIRES RATE_LIMIT_BACKEND=redis — otherwise each
# worker gets its own rate/token budget and every ceiling is silently
# multiplied. Startup refuses that combination.
API_WORKERS=1

# Response cache (Redis — identical question+mode hits for 1 hour)
CACHE_ENABLED=true
# Password comes from REDIS_PASSWORD; compose builds this URL for you.
REDIS_URL=redis://:your-redis-password@redis:6379/0
CACHE_TTL_SECONDS=3600

# LangSmith (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-rag-prod

# Conversation memory (optional Supabase — apply docs/supabase_schema.sql first,
# which enables RLS and installs the retention sweep)
MEMORY_ENABLED=true
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_CHAT_TABLE=chat_messages

# --- Required by docker-compose (read from the shell, not this file) ---------
# Export these before `docker compose up`, or put them in a .env file next to
# docker-compose.yml. Compose fails fast if any is missing.
#   REDIS_PASSWORD=$(openssl rand -hex 24)
#   API_KEY=<same value as API_KEY above>
#   GRAFANA_ADMIN_PASSWORD=$(openssl rand -hex 16)
