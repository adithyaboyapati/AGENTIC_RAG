# Backend base URL (leave empty in dev to use Vite proxy → /api)
VITE_API_BASE_URL=

# Server-side only (Vite proxy / nginx). NOT prefixed with VITE_ — never baked into the JS bundle.
# Copy to frontend/.env for local `npm run dev`:
API_KEY=

# Optional escape hatch: send X-API-Key from the browser (direct API access without proxy).
# Prefer API_KEY + proxy instead.
# VITE_API_KEY=
